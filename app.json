{
  "expo": {
    "name": "Assistant",
    "slug": "Assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "assistant",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.jaskiratoberoi.assistant",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Assistant turns your speech into text so it can answer you.",
        "NSMicrophoneUsageDescription": "Assistant uses the microphone so you can talk to it."
      }
    },
    "android": {
      "package": "com.jaskiratoberoi.assistant",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F6BFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Assistant uses the microphone so you can talk to it.",
          "speechRecognitionPermission": "Assistant turns your speech into text so it can answer you."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2F6BFF",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7a1202fa-9625-4354-8c87-6b0aab3a5fac"
      }
    },
    "owner": "jaskiratoberoi-noble"
  }
}
