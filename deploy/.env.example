# Copy to deploy/.env and fill in. Never commit deploy/.env.
SNAPCLAIM_DB_PASSWORD=change-me
# 32+ random bytes, base64 or plain text
SNAPCLAIM_JWT_SIGNING_KEY=change-me-to-a-long-random-string-of-at-least-32-bytes
SNAPCLAIM_JWT_ISSUER=snapclaim-api
SNAPCLAIM_COMPANY_NAME=Stellar Infomatica
SNAPCLAIM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SNAPCLAIM_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# Comma-separated browser origins allowed to call the API (the web app's origin)
SNAPCLAIM_CORS_ORIGINS=https://snapclaim.example.com
# Where the web build reaches the API from the browser
SNAPCLAIM_PUBLIC_API_URL=https://api-snapclaim.example.com
# Company key for Snap & Extract. Leave empty to disable extraction (manual entry only).
ANTHROPIC_API_KEY=
SNAPCLAIM_CLAUDE_MODEL=claude-opus-5-5
# Host ports (loopback only; put Caddy or nginx in front)
SNAPCLAIM_API_PORT=3170
SNAPCLAIM_WEB_PORT=3171
