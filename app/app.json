{
  "expo": {
    "name": "SnapClaim",
    "slug": "snapclaim",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snapclaim",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.stellarinfomatica.snapclaim",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SnapClaim uses the camera to snap receipts for expense claims.",
        "NSPhotoLibraryUsageDescription": "SnapClaim reads receipt photos you choose from your library."
      }
    },
    "android": {
      "package": "com.stellarinfomatica.snapclaim",
      "adaptiveIcon": {
        "backgroundColor": "#F6F4EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "SnapClaim uses the camera to snap receipts for expense claims.",
          "photosPermission": "SnapClaim reads receipt photos you choose from your library.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "71fdc5cd-6e4d-4dbd-b23e-8d9363b360f6"
      }
    },
    "owner": "jaskiratoberoi"
  }
}
